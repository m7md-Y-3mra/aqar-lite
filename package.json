    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
