# PostgreSQL connection URL for the application database.
DATABASE_URL=postgresql://aqar:aqar@localhost:5432/aqar
# Exact browser origin allowed to send mutating requests.
APP_ORIGIN=http://localhost:3000
# Logging verbosity; defaults to info when unset.
LOG_LEVEL=info

# Tooling only (not read by the app)
TEST_DATABASE_URL=postgresql://aqar:aqar@localhost:5432/aqar_test
