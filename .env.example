# PostgreSQL connection URL for the application database.
DATABASE_URL=postgresql://aqar:aqar@localhost:5433/aqar
# Browser origins allowed to send mutating requests: a comma-separated list, each matched exactly.
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Logging verbosity; defaults to info when unset.
LOG_LEVEL=info

# Tooling only (not read by the app)
TEST_DATABASE_URL=postgresql://aqar:aqar@localhost:5433/aqar_test
# Host port docker compose publishes the database on (loopback only).
DB_HOST_PORT=5433
